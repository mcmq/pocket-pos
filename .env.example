# Copy to .env and fill in values from Firebase Console → Project settings.
# See docs/setup.md for where each value comes from.

FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.example.pocketPos

# Dev only: connect to local Firebase emulators
USE_FIREBASE_EMULATOR=false
