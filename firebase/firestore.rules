rules_version = '2';

// PocketPOS security rules. See docs/data-model.md → Firestore layout.
// A user can read and write shops/{shopId}/** only if they own the shop or
// are an active member. Role checks (cashier restrictions) arrive with
// roles in P1.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId));
    }

    function isOwner(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && shopDoc(shopId).data.ownerUid == request.auth.uid;
    }

    // State after the current batch: the shop and its owner's member doc
    // are created together on first sync.
    function isOwnerAfterWrite(shopId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    function isMember(shopId) {
      let path = /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.active == true;
    }

    function canAccess(shopId) {
      return isOwner(shopId) || isMember(shopId);
    }

    match /shops/{shopId} {
      // Lets a fresh install find the shop owned by the signed-in account.
      allow read: if signedIn()
        && (resource == null || resource.data.ownerUid == request.auth.uid || isMember(shopId));
      // Creating a shop: the creator must claim ownership.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Ownership can never be transferred from the client.
      allow update: if canAccess(shopId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if canAccess(shopId);
        // Only the owner manages members (invites are P1).
        allow write: if isOwnerAfterWrite(shopId);
      }

      // Synced tables. Rows are soft-deleted (deletedAt), never removed.
      match /{collection}/{docId} {
        allow read: if canAccess(shopId);
        allow create, update: if canAccess(shopId)
          && collection in ['categories', 'products', 'parties', 'taxRates',
                            'transactions', 'payments', 'stockMovements']
          && request.resource.data.shopId == shopId;
        allow delete: if false;
      }
    }
  }
}
